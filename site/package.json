    "dados:itens": "tsx scripts/ingerir-itens.ts",
    "dados:faq": "tsx scripts/ingerir-faq.ts",
    "dados:controles": "tsx scripts/ingerir-controles.ts",
    "icones:baixar": "tsx scripts/baixar-icones.ts",
    "icones": "tsx scripts/otimizar-icones.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "dotenv -e .env.local -- drizzle-kit migrate",
    "db:migrate:test": "dotenv -e .env.test -- drizzle-kit migrate",
    "dados:migrar-editorial": "tsx scripts/migrar-eventos-codigos.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
